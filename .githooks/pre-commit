#!/bin/sh
# Checks formatting before each commit. Enabled by `make setup`
# (git config core.hooksPath .githooks).

if ! docker compose ps --status running --services 2>/dev/null | grep -qx app; then
  echo "[pre-commit] 'app' container is not running: lint skipped. Run 'make up' to validate."
  exit 0
fi

echo "[pre-commit] Running lint..."
if ! make lint; then
  echo "[pre-commit] Formatting issues found. Run 'make fmt' and stage the changes."
  exit 1
fi
